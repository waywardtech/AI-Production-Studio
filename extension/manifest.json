{
  "manifest_version": 3,
  "name": "Edge Studio",
  "short_name": "Edge Studio",
  "version": "0.8.0",
  "description": "Prompt composer, reply manager and video production pipeline for ChatGPT, Claude and Gemini: block-based prompt building, one-click injection, platform-targeted optimization, reply capture, and a three-column scene builder that composes clip prompts for Sora and Veo.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "clipboardWrite",
    "sidePanel",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://sora.chatgpt.com/*",
    "https://labs.google/fx/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Edge Studio",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://sora.chatgpt.com/*",
        "https://labs.google/fx/*"
      ],
      "js": [
        "content-scripts/chat-adapter.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
