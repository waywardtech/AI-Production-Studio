{
  "manifest_version": 3,
  "name": "Far Edge Studio — Prompt Composer",
  "short_name": "Far Edge Composer",
  "version": "0.2.0",
  "description": "Block-based prompt builder with drag-and-drop composition and one-click injection into ChatGPT. Phase 1 MVP.",
  "permissions": ["storage", "tabs", "scripting", "clipboardWrite", "sidePanel"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Far Edge Studio"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content-scripts/chatgpt-inject.js"],
      "run_at": "document_idle"
    }
  ]
}
